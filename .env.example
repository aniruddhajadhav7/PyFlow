# PyFlow Configuration
APP_NAME=PyFlow
DEBUG=True
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pyflow

# Rate Limiting
RATE_LIMIT_ALGORITHM=token_bucket
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Worker
WORKER_CONCURRENCY=100
WORKER_QUEUES=default

# Task Settings
TASK_RESULT_TTL=86400
TASK_MAX_RETRIES=3
TASK_RETRY_BASE_DELAY=5
